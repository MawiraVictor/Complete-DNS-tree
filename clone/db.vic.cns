$TTL 604800
@       IN      SOA     ns1.vic.cns. admin.vic.cns. (
                        2026100801 ; Serial
                        604800     ; Refresh
                        86400      ; Retry
                        2419200    ; Expire
                        604800 )   ; Negative Cache TTL
;
@       IN      NS      ns1.vic.cns.
@       IN      NS      ns2.vic.cns.
@       IN      A       192.168.100.29
@       IN      MX  10  mail.vic.cns.

ns1     IN      A       192.168.100.29
ns2     IN      A       192.168.100.28
mail    IN      A       192.168.100.29
nfs     IN      A       192.168.100.29
smb     IN      A       192.168.100.29
ldap    IN      A       192.168.100.29
www     IN      A       192.168.100.29
sqlslv1 IN      A       192.168.100.29
