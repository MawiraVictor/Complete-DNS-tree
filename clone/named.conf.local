// ===== vic.cns (master) =====
zone "vic.cns" {
    type master;
    file "/etc/bind/db.vic.cns";
    allow-transfer { 172.29.169.236; };
    also-notify { 172.29.169.236; };
    notify yes;
};

// ===== Reverse (master) =====
zone "169.29.172.in-addr.arpa" {
    type master;
    file "/etc/bind/db.172.29.169";
    allow-transfer { 172.29.169.236; };
    also-notify { 172.29.169.236; };
    notify yes;
};

// ===== Slaves of Main =====
zone "." {
    type slave;
    file "/var/cache/bind/db.root";
    masters { 172.29.169.236; };
};

zone "cns" {
    type slave;
    file "/var/cache/bind/db.cns";
    masters { 172.29.169.236; };
};

zone "ozy.cns" {
    type slave;
    file "/var/cache/bind/db.ozy.cns";
    masters { 172.29.169.236; };
};

zone "eng.ozy.cns" {
    type slave;
    file "/var/cache/bind/db.eng.ozy.cns";
    masters { 172.29.169.236; };
};
