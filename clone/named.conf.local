// ===== Second-level zone: vic.cns (master on Clone) =====
zone "vic.cns" {
    type master;
    file "/etc/bind/db.vic.cns";
    allow-transfer { 192.168.100.28; };
    also-notify { 192.168.100.28; };
    notify yes;
};

// ===== Reverse zone (master on Clone) =====
zone "100.168.192.in-addr.arpa" {
    type master;
    file "/etc/bind/db.192.168.100";
    allow-transfer { 192.168.100.28; };
    also-notify { 192.168.100.28; };
    notify yes;
};

// ===== Slaves of Main's zones =====
zone "." {
    type slave;
    file "/var/cache/bind/db.root";
    masters { 192.168.100.28; };
};

zone "cns" {
    type slave;
    file "/var/cache/bind/db.cns";
    masters { 192.168.100.28; };
};

zone "ozy.cns" {
    type slave;
    file "/var/cache/bind/db.ozy.cns";
    masters { 192.168.100.28; };
};

zone "eng.ozy.cns" {
    type slave;
    file "/var/cache/bind/db.eng.ozy.cns";
    masters { 192.168.100.28; };
};
