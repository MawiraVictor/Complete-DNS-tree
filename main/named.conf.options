options {
    directory "/var/cache/bind";

    // Only real upstream DNS servers (remove the self-reference and unreachable ones)
    forwarders {
        8.8.8.8;
        1.1.1.1;
    };

    // Disable DNSSEC validation (avoids root DNSKEY timeouts in isolated lab)
    dnssec-validation no;

    // Listen on all interfaces
    listen-on { any; };
    listen-on-v6 { any; };

    // Allow recursion for your local network
    recursion yes;
    allow-recursion { localhost; 10.82.119.0/24; };
    allow-query { any; };
};
