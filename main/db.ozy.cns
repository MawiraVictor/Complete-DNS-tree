$TTL 604800
@       IN      SOA     ns1.ozy.cns. admin.ozy.cns. (
                        2026100501 ; Serial (YYYYMMDDNN)
                        604800     ; Refresh
                        86400      ; Retry
                        2419200    ; Expire
                        604800 )   ; Negative Cache TTL
;
@       IN      NS      ns1.ozy.cns.
@       IN      NS      ns2.ozy.cns.
@       IN      A       192.168.100.28
@       IN      MX  10  mail.ozy.cns.

; ---- nameservers ----
ns1     IN      A       192.168.100.28
ns2     IN      A       192.168.100.29

; ---- delegation to eng.ozy.cns ----
eng.ozy.cns.         IN      NS      ns1.eng.ozy.cns.
eng.ozy.cns.         IN      NS      ns2.eng.ozy.cns.
ns1.eng.ozy.cns.     IN      A       192.168.100.28
ns2.eng.ozy.cns.     IN      A       192.168.100.29

; ---- hosts in ozy.cns ----
mail    IN      A       192.168.100.28
nfs     IN      A       192.168.100.28
smb     IN      A       192.168.100.28
ldap    IN      A       192.168.100.28
www     IN      A       192.168.100.28
stu     IN      A       192.168.100.28
sqlmst  IN      A       192.168.100.28
