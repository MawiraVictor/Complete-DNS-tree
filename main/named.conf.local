// ===== Root zone =====
zone "." {
    type master;
    file "/etc/bind/db.root";
    allow-transfer { 172.29.169.144; };
    also-notify { 172.29.169.144; };
    notify yes;
};

// ===== TLD zone =====
zone "cns" {
    type master;
    file "/etc/bind/db.cns";
    allow-transfer { 172.29.169.144; };
    also-notify { 172.29.169.144; };
    notify yes;
};

// ===== ozy.cns =====
zone "ozy.cns" {
    type master;
    file "/etc/bind/db.ozy.cns";
    allow-transfer { 172.29.169.144; };
    also-notify { 172.29.169.144; };
    notify yes;
};

// ===== eng.ozy.cns =====
zone "eng.ozy.cns" {
    type master;
    file "/etc/bind/db.eng.ozy.cns";
    allow-transfer { 172.29.169.144; };
    also-notify { 172.29.169.144; };
    notify yes;
};

// ===== Reverse =====
zone "169.29.172.in-addr.arpa" {
    type master;
    file "/etc/bind/db.172.29.169";
    allow-transfer { 172.29.169.144; };
    also-notify { 172.29.169.144; };
    notify yes;
};

// ===== Slave of vic.cns =====
zone "vic.cns" {
    type slave;
    file "/var/cache/bind/db.vic.cns";
    masters { 172.29.169.144; };
};
