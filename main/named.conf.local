// ===== Root zone =====
zone "." {
    type master;
    file "/etc/bind/db.root";
    allow-transfer { 192.168.100.29; };
    also-notify { 192.168.100.29; };
    notify yes;
};

// ===== TLD zone =====
zone "cns" {
    type master;
    file "/etc/bind/db.cns";
    allow-transfer { 192.168.100.29; };
    also-notify { 192.168.100.29; };
    notify yes;
};

// ===== Second-level zone: ozy.cns =====
zone "ozy.cns" {
    type master;
    file "/etc/bind/db.ozy.cns";
    allow-transfer { 192.168.100.29; };
    also-notify { 192.168.100.29; };
    notify yes;
};

// ===== Third-level zone: eng.ozy.cns =====
zone "eng.ozy.cns" {
    type master;
    file "/etc/bind/db.eng.ozy.cns";
    allow-transfer { 192.168.100.29; };
    also-notify { 192.168.100.29; };
    notify yes;
};

// ===== Reverse zone =====
zone "100.168.192.in-addr.arpa" {
    type master;
    file "/etc/bind/db.192.168.100";
    allow-transfer { 192.168.100.29; };
    also-notify { 192.168.100.29; };
    notify yes;
};

// ===== Slave of vic.cns (from Clone) =====
zone "vic.cns" {
    type slave;
    file "/var/cache/bind/db.vic.cns";
    masters { 192.168.100.29; };
};
