$TTL 604800
@       IN      SOA     ozy.cns. root.ozy.cns. (
                        2026100801 ; Serial
                        604800     ; Refresh
                        86400      ; Retry
                        2419200    ; Expire
                        604800 )   ; Negative Cache TTL
;
@       IN      NS      ns1.ozy.cns.
@       IN      NS      ns2.ozy.cns.

28      IN      PTR     mail.ozy.cns.
28      IN      PTR     ozy.cns.
29      IN      PTR     mail.vic.cns.
29      IN      PTR     vic.cns.
